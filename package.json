{
    "name": "vouchly",
    "version": "0.1.0",
    "type": "module",
    "description": "Verify OAuth2 and OIDC tokens against trusted issuers: JWT, introspection and certificate-bound tokens, on any Web runtime.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/vouchly.git"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [
        "oauth2",
        "oidc",
        "jwt",
        "jwks",
        "introspection",
        "token-verification",
        "mtls"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.2",
        "@tada5hi/eslint-config": "^2.4.0",
        "@tada5hi/tsconfig": "^0.7.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.12.0",
        "husky": "^9.1.7",
        "tsdown": "^0.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "jose": "^6.2.12"
    }
}
